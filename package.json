{
  "name": "longchat-guard",
  "version": "1.0.0",
  "description": "Local-first ChatGPT long-conversation warning, conversation length monitor and context-risk browser extension for Chrome and Edge.",
  "keywords": [
    "chatgpt",
    "chatgpt-extension",
    "browser-extension",
    "chrome-extension",
    "edge-extension",
    "long-conversation",
    "long-chat",
    "conversation-guard",
    "conversation-length",
    "context-window",
    "context-warning",
    "context-monitor",
    "privacy-first",
    "local-first",
    "manifest-v3"
  ],
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luobo656/longchat-guard.git"
  },
  "bugs": {
    "url": "https://github.com/luobo656/longchat-guard/issues"
  },
  "homepage": "https://luobo656.github.io/longchat-guard/",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.content.config.ts && npm run verify:dist",
    "verify:dist": "node scripts/verify-extension-build.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  }
}
